{
    "name": "Kochbuch",
    "short_name": "Kochbuch",
    "description": "Rezepte anlegen, durchsuchen und teilen.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#ff6f00",
    "theme_color": "#ff6f00",
    "share_target": {
        "action": "./share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{ "name": "images", "accept": ["image/jpeg", "image/png", "image/webp", ".jpg", ".jpeg", ".png", ".webp"] }]
        }
    },
    "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
    ]
}
