{
    "name": "Kochbuch",
    "short_name": "Kochbuch",
    "description": "Rezepte anlegen, durchsuchen und teilen.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#ff6f00",
