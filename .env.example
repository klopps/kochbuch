# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=local
APP_DEBUG=true
APP_NAME=Kochbuch

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kochbuch
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Generate a long random string, e.g.: php -r "echo bin2hex(random_bytes(32));"
# Must be at least 32 bytes (AuthService enforces this at boot) - firebase/php-jwt
# rejects shorter HS256 keys since CVE-2025-45769.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
# 10 years - login should only end via manual logout, not by silently expiring
# (see todo.md: "Wenn man angemeldet ist, soll die Session theoretisch unendlich bestehen bleiben")
JWT_TTL_SECONDS=315360000

# Comma-separated list of allowed CORS origins for the API, e.g. https://app.kochbuch.example,capacitor://localhost
ALLOWED_ORIGINS=*

# Comma-separated list of UI locales the app supports (resources/i18n/{locale}.json
# must exist for each) - first entry is the fallback when a visitor's stored
# preference/Accept-Language doesn't match any of them.
SUPPORTED_LOCALES=de,en

# Fully qualified base URL of this deployment (scheme+host+optional subdir,
# NO trailing slash), used to build absolute links (e.g. shared recipe links,
# invite/reset emails) since the per-request base path has no scheme/host of its own.
APP_URL=https://example.com/kochbuch/public

# SSH credentials used only by bin/deploy.bat / bin/deploy.sh, read from this
# file when DEPLOY_SSH_PASSWORD isn't already set as an environment variable.
# Never commit a real value.
DEPLOY_SSH_PASSWORD=
