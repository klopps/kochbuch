{
    "name": "steindorff/kochbuch",
    "description": "Kochbuch - mobile-first recipe web app (web API + web app)",
    "type": "project",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kochbuch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kochbuch\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-db": "php bin/setup-test-db.php",
        "post-install-cmd": "@php bin/configure-git-hooks.php",
        "post-update-cmd": "@php bin/configure-git-hooks.php"
    }
}
